<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.bankportal.util.Web" %><%List<Map<String,Object>> accounts=(List<Map<String,Object>>)request.getAttribute("accounts");String token=Web.csrf(session);Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer dashboard · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="appbar"><a class="brand" href="<%=request.getContextPath()%>/customer/dashboard"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a class="active" href="<%=request.getContextPath()%>/customer/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/transactions">Transactions</a><a href="<%=request.getContextPath()%>/profile">My profile</a><span class="user-chip"><%=session.getAttribute("username")%></span><a href="<%=request.getContextPath()%>/logout">Sign out</a></nav></header><main class="page-shell"><div class="welcome-row"><div><span class="eyebrow">CUSTOMER WORKSPACE</span><h1>Welcome, <%=session.getAttribute("username")%></h1><p>View your accounts and manage everyday transactions.</p></div><a class="btn btn-light" href="<%=request.getContextPath()%>/transactions">View all transactions →</a></div><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%><div class="metric-grid"><div class="metric-card"><span>My accounts</span><strong><%=accounts==null?0:accounts.stream().filter(a->a.get("accountId")!=null).count()%></strong><small>Accounts created by the employee</small></div><div class="metric-card"><span>Application status</span><strong class="metric-text"><%=accounts!=null&&!accounts.isEmpty()?accounts.get(0).get("applicationStatus"):"—"%></strong><small>Approval status of your application</small></div><div class="metric-card"><span>Quick access</span><strong class="metric-text">Transactions</strong><small>Review your deposit and withdrawal history</small></div></div><section class="panel"><div class="panel-heading"><div><h2>Your accounts</h2><p>Balances and account status</p></div></div><div class="table-wrap"><table><thead><tr><th>Account number</th><th>Type</th><th>Balance</th><th>Status</th></tr></thead><tbody><%boolean any=false;if(accounts!=null)for(Map<String,Object>a:accounts){if(a.get("accountId")!=null){any=true;%><tr><td class="mono"><%=a.get("accountNumber")%></td><td><%=a.get("accountType")%></td><td class="money">₹<%=a.get("balance")%></td><td><span class="pill <%=String.valueOf(a.get("accountStatus")).equals("ACTIVE")?"pill-green":"pill-gray"%>"><%=a.get("accountStatus")%></span></td></tr><%}}if(!any){%><tr><td colspan="4" class="empty-cell">No account is available yet. Your application must be approved and an employee must create an account.</td></tr><%}%></tbody></table></div></section><section class="panel"><div class="panel-heading"><div><h2>Make a transaction</h2><p>Use only an active account. Transactions are part of this educational demo ledger.</p></div></div><form method="post" action="<%=request.getContextPath()%>/customer/transaction" class="form-grid compact-grid" data-validate><input type="hidden" name="csrfToken" value="<%=token%>"><label>Account *<select name="accountId" required><option value="">Select account</option><%if(accounts!=null)for(Map<String,Object>a:accounts)if(a.get("accountId")!=null){%><option value="<%=a.get("accountId")%>"><%=a.get("accountNumber")%> · <%=a.get("accountType")%> · <%=a.get("accountStatus")%></option><%}%></select></label><label>Transaction type *<select name="action" required><option value="">Choose operation</option><option value="DEPOSIT">Deposit</option><option value="WITHDRAWAL">Withdrawal</option></select></label><label>Amount (₹) *<input type="number" name="amount" required min="0.01" max="100000000" step="0.01"></label><label>Description<input name="description" maxlength="255" placeholder="Optional note"></label><div class="form-actions span-2"><button class="btn btn-primary" type="submit">Submit transaction</button><button class="btn btn-light" type="reset">Reset</button></div></form></section></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
