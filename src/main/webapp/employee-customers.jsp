<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.bankportal.util.Web" %><%List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("customers");String filter=(String)request.getAttribute("statusFilter");String token=Web.csrf(session);Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer management · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="appbar"><a class="brand" href="<%=request.getContextPath()%>/employee/dashboard"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a href="<%=request.getContextPath()%>/employee/dashboard">Dashboard</a><a class="active" href="<%=request.getContextPath()%>/employee/customers">Customers</a><a href="<%=request.getContextPath()%>/employee/accounts">Accounts</a><a href="<%=request.getContextPath()%>/transactions">Transactions</a><a href="<%=request.getContextPath()%>/profile">My profile</a><a href="<%=request.getContextPath()%>/logout">Sign out</a></nav></header><main class="page-shell"><div class="welcome-row"><div><span class="eyebrow">CUSTOMER OPERATIONS</span><h1>Customer management</h1><p>Review applications, update customer details and control access.</p></div><a class="btn btn-light" href="<%=request.getContextPath()%>/employee/accounts">Manage accounts →</a></div><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%><section class="panel"><div class="panel-heading"><div><h2>Customer records</h2><p>Use View / edit to access full record details.</p></div><form method="get" class="inline-filter"><label class="sr-only" for="status">Filter status</label><select id="status" name="status" onchange="this.form.submit()"><option value="ALL" <%=filter.equals("ALL")?"selected":""%>>All statuses</option><option value="PENDING" <%=filter.equals("PENDING")?"selected":""%>>Pending</option><option value="APPROVED" <%=filter.equals("APPROVED")?"selected":""%>>Approved</option><option value="REJECTED" <%=filter.equals("REJECTED")?"selected":""%>>Rejected</option></select></form></div><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Login / contact</th><th>Identity type</th><th>Account number</th><th>Application status</th><th>Login access</th><th>Actions</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object>r:rows){%><tr><td><b><%=r.get("full_name")%></b><br><small>ID: <%=r.get("customer_id")%> · <%=r.get("gender")%></small></td><td><%=r.get("username")%><br><small><%=r.get("email")%> · <%=r.get("mobile")%></small></td><td><%=r.get("identity_type")%></td><td><b><%=r.get("account_number")==null?"Not Assigned":r.get("account_number")%></b></td><td><span class="pill pill-<%=String.valueOf(r.get("account_status")).toLowerCase()%>"><%=r.get("account_status")%></span></td><td><b><%=r.get("login_status")%></b></td><td class="action-cell"><details class="row-details"><summary>View / edit</summary><div class="details-panel"><form method="post" action="<%=request.getContextPath()%>/employee/customer-action" class="stack-form" data-validate><input type="hidden" name="csrfToken" value="<%=token%>"><input type="hidden" name="customerId" value="<%=r.get("customer_id")%>"><input type="hidden" name="action" value="UPDATE"><label>Full name<input name="fullName" value="<%=r.get("full_name")%>" required maxlength="100"></label><label>Email<input type="email" name="email" value="<%=r.get("email")%>" required></label><label>Mobile<input name="mobile" value="<%=r.get("mobile")%>" required pattern="[0-9+ -]{8,15}"></label><label>Address<textarea name="address" rows="2" required><%=r.get("address")%></textarea></label><button class="btn btn-primary btn-small" type="submit">Save changes</button></form><div class="detail-actions">
<form method="post" action="<%=request.getContextPath()%>/employee/customer-action" onsubmit="return confirm('Change this customer login permission?');">
<input type="hidden" name="csrfToken" value="<%=token%>">
<input type="hidden" name="customerId" value="<%=r.get("customer_id")%>">
<%if("ACTIVE".equals(r.get("login_status"))){%>
<button class="btn btn-danger btn-small" name="action" value="DEACTIVATE_LOGIN">Deactivate Login</button>
<%}else{%>
<button class="btn btn-success btn-small" name="action" value="ACTIVATE">Activate Login</button>
<%}%>
</form>
<%if("PENDING".equals(r.get("account_status"))){%><form method="post" action="<%=request.getContextPath()%>/employee/customer-action"><input type="hidden" name="csrfToken" value="<%=token%>"><input type="hidden" name="customerId" value="<%=r.get("customer_id")%>"><button class="btn btn-success btn-small" name="action" value="APPROVE">Approve</button><button class="btn btn-danger btn-small" name="action" value="REJECT">Reject</button></form><%}%><form method="post" action="<%=request.getContextPath()%>/employee/customer-action" onsubmit="return confirm('Deactivate this customer login and all associated accounts?');"><input type="hidden" name="csrfToken" value="<%=token%>"><input type="hidden" name="customerId" value="<%=r.get("customer_id")%>"><button class="btn btn-light btn-small" name="action" value="DEACTIVATE">Deactivate</button></form></div><p class="helper">Identity filename: <%=r.get("identity_file_name")==null?"Not uploaded":r.get("identity_file_name")%></p></div></details></td></tr><%}%></tbody></table></div></section></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
