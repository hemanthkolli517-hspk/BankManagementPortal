<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="in.bankportal.util.Web" %>
<%String token=Web.csrf(session);Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Employee registration · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a href="<%=request.getContextPath()%>/login.jsp">Sign in</a></nav></header><main class="page-shell narrow"><div class="page-heading"><span class="eyebrow">EMPLOYEE ACCESS</span><h1>Employee registration</h1><p>Verify your email before submitting your employee profile.</p></div><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%><form id="employeeForm" class="form-card form-grid" method="post" action="<%=request.getContextPath()%>/employee/register" data-validate><input type="hidden" name="csrfToken" value="<%=token%>"><h2 class="section-title span-2">Account credentials</h2><label>Username *<input name="username" required minlength="4" maxlength="50"></label><label>Password *<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"></label><label>Email address *<input id="employeeEmail" type="email" name="email" required maxlength="100"></label><label>Mobile number *<input name="mobile" required pattern="[0-9+ -]{8,15}" maxlength="15"></label>
<div class="otp-panel span-2"><div><b>Email verification</b><p>Send a six-digit code to the email above. It expires in 10 minutes.</p></div><button id="sendOtp" class="btn btn-light" type="button" data-url="<%=request.getContextPath()%>/employee/send-otp">Send OTP</button><label class="span-2">Email OTP *<input name="otp" required inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="Enter the 6-digit code"></label><div id="otpMessage" class="helper span-2" aria-live="polite"></div></div>
<h2 class="section-title span-2">Employee information</h2><label>Employee code *<input name="employeeCode" required maxlength="20" placeholder="e.g. EMP-2026-001"></label><label>Designation *<input name="designation" required maxlength="50" placeholder="Branch Officer"></label><label>Department *<select name="department" required><option value="">Select department</option><option>Operations</option><option>Customer Service</option><option>Accounts</option><option>Loans</option><option>IT</option><option>Compliance</option><option>Administration</option></select></label><label>Work location type *<select name="locationType" required><option value="">Select option</option><option>Branch office</option><option>Head office</option><option>Remote office</option></select></label><label class="span-2">Office address *<textarea name="address" rows="3" required maxlength="1000"></textarea></label><label class="checkbox-row span-2"><input type="checkbox" required name="employeeDeclaration"> I confirm that I am authorized to request employee access.</label><div class="form-actions span-2"><button class="btn btn-primary" type="submit">Verify and register employee</button><button class="btn btn-light" type="reset">Reset form</button></div><p class="form-footnote span-2">Employee self-registration is enabled for this educational demo. Restrict it to approved staff invitations before production use.</p></form></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
