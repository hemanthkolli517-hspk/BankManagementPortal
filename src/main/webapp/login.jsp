<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="in.bankportal.util.Web" %>
<%
if(session.getAttribute("userId")!=null){response.sendRedirect(request.getContextPath()+"/dashboard");return;}
String msg=request.getParameter("msg");Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");
%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="auth-page"><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-mark">B</span> Bank<span>wise</span></a><a href="<%=request.getContextPath()%>/">Back to home</a></header><main class="auth-wrap"><section class="auth-intro"><span class="eyebrow">WELCOME BACK</span><h1>Your banking workspace, all in one place.</h1><p>Sign in to view accounts, applications and transactions based on your role.</p><ul class="check-list"><li>Customer self-service dashboard</li><li>Employee account management</li><li>Protected sessions and role access</li></ul></section><section class="form-card"><div class="form-heading"><div class="brand-mark">B</div><h2>Sign in</h2><p>Enter your username and password. A verification code will be sent to your registered email.</p></div>
<% if(msg!=null){%><div class="alert alert-error"><%=msg.replace("+"," ")%></div><%}%><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/login" class="stack-form" data-validate>
<label>Username<input name="username" autocomplete="username" required minlength="4" placeholder="Your username"></label><label>Password<input type="password" name="password" autocomplete="current-password" required placeholder="Your password"></label><button class="btn btn-primary btn-full" type="submit">Sign in securely</button></form><div class="form-links"><a href="<%=request.getContextPath()%>/register.jsp">Customer registration</a><a href="<%=request.getContextPath()%>/employee-register.jsp">Employee registration</a></div><p class="form-footnote">Your session automatically expires after 15 minutes of inactivity.</p></section></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
