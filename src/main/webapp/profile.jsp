<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.bankportal.util.Web" %><%Map<String,Object> p=(Map<String,Object>)request.getAttribute("profile");String role=Web.role(request);String token=Web.csrf(session);Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My profile · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="appbar"><a class="brand" href="<%=request.getContextPath()%>/dashboard"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><%if("EMPLOYEE".equals(role)){%><a href="<%=request.getContextPath()%>/employee/customers">Customers</a><a href="<%=request.getContextPath()%>/employee/accounts">Accounts</a><%}else if("ADMIN".equals(role)){%><a href="<%=request.getContextPath()%>/admin/dashboard">Admin dashboard</a><%}%><a href="<%=request.getContextPath()%>/transactions">Transactions</a><a class="active" href="<%=request.getContextPath()%>/profile">My profile</a><a href="<%=request.getContextPath()%>/logout">Sign out</a></nav></header><main class="page-shell narrow"><div class="page-heading"><span class="eyebrow">ACCOUNT SETTINGS</span><h1>My profile</h1><p><%="CUSTOMER".equals(role)?"Your registered details are read-only. Contact the administrator for corrections.":"Review your profile details. Leave the new password blank to keep it unchanged."%></p></div><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%><form method="post" action="<%=request.getContextPath()%>/profile" class="form-card form-grid" data-validate><input type="hidden" name="csrfToken" value="<%=token%>"><h2 class="section-title span-2">Login and contact</h2><label>Username<input value="<%=p.get("username")%>" disabled></label><label>Role<input value="<%=role%>" disabled></label><label>Email address *<input type="email" name="email" required value="<%=p.get("email")%>" <%= "CUSTOMER".equals(role)?"readonly":"" %>></label><label>Mobile number *<input name="mobile" required pattern="[0-9+ -]{8,15}" value="<%=p.get("mobile")%>" <%= "CUSTOMER".equals(role)?"readonly":"" %>></label><%if("CUSTOMER".equals(role)){%><h2 class="section-title span-2">Personal details</h2><label class="span-2">Full name *<input value="<%=p.get("full_name")%>" readonly></label><label class="span-2">Address *<textarea rows="3" readonly><%=p.get("address")%></textarea></label><label>Date of birth<input value="<%=p.get("dob")==null?"":p.get("dob")%>" disabled></label><label>Gender<input value="<%=p.get("gender")%>" disabled></label><label>Identity type<input value="<%=p.get("identity_type")%>" disabled></label><label>Account number<input value="<%=p.get("account_number")==null?"Not assigned":p.get("account_number")%>" disabled></label><%}else{%><h2 class="section-title span-2">Employee information</h2><label>Employee code<input value="<%=p.get("employee_code")%>" disabled></label><label>Designation<input value="<%=p.get("designation")%>" disabled></label><label>Department<input value="<%=p.get("department")%>" disabled></label><%}%><%if(!"CUSTOMER".equals(role)){%><h2 class="section-title span-2">Change password</h2><label class="span-2">New password<input type="password" name="newPassword" minlength="8" maxlength="72" autocomplete="new-password"><small>At least 8 characters. Leave blank if no change is required.</small></label><div class="form-actions span-2"><button class="btn btn-primary" type="submit">Save profile</button><button class="btn btn-light" type="reset">Reset</button></div><%}else{%><div class="form-actions span-2"><a class="btn btn-light" href="<%=request.getContextPath()%>/customer/dashboard">Back to dashboard</a></div><%}%></form></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
