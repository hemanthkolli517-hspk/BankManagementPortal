<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="in.bankportal.util.Web" %>
<%String token=Web.csrf(session);Object flash=session.getAttribute("flashMessage");Object kind=session.getAttribute("flashKind");session.removeAttribute("flashMessage");session.removeAttribute("flashKind");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer registration · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a href="<%=request.getContextPath()%>/login.jsp">Sign in</a></nav></header><main class="page-shell narrow"><div class="page-heading"><span class="eyebrow">CUSTOMER SERVICES</span><h1>Start your customer application</h1><p>Submit your details for employee review. Fields marked * are required.</p></div><%if(flash!=null){%><div class="alert alert-<%=kind%>"><%=flash%></div><%}%><form class="form-card form-grid" method="post" action="<%=request.getContextPath()%>/register" enctype="multipart/form-data" data-validate><input type="hidden" name="csrfToken" value="<%=token%>"><h2 class="section-title span-2">Login details</h2><label>Username *<input name="username" required minlength="4" maxlength="50" autocomplete="username"></label><label>Password *<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"><small>Use at least 8 characters.</small></label><label>Email address *<input type="email" name="email" required maxlength="100" autocomplete="email"></label><label>Mobile number *<input name="mobile" required pattern="[0-9+ -]{8,15}" maxlength="15" inputmode="tel"></label><h2 class="section-title span-2">Personal information</h2><label>Full name *<input name="fullName" required maxlength="100"></label><label>Account number (optional)<input name="accountNumber" maxlength="20" pattern="[A-Za-z0-9-]{1,20}" autocomplete="off"><small>Enter an existing account number if applicable; otherwise leave blank.</small></label><label>Date of birth<input type="date" name="dob" max="<%=java.time.LocalDate.now().toString()%>"></label><label>Gender *<select name="gender" required><option value="">Choose gender</option><option>Female</option><option>Male</option><option>Other</option></select></label><label>Identity document type *<select name="identityType" required><option value="">Choose document type</option><option>Aadhaar</option><option>Passport</option><option>Driving Licence</option><option>Voter ID</option><option>Other</option></select></label><label class="span-2">Address *<textarea name="address" required rows="3" maxlength="1000" placeholder="House / street, town, state and PIN code"></textarea></label><label class="span-2">Identity document (PDF, JPG or PNG; max 2 MB)<input type="file" name="identityFile" accept=".pdf,.jpg,.jpeg,.png"><small>Demo stores the uploaded file in a private local folder; use test documents only.</small></label><label class="checkbox-row span-2"><input type="checkbox" name="declaration" required> I confirm that the information supplied is accurate.</label><div class="form-actions span-2"><button class="btn btn-primary" type="submit">Submit application</button><button class="btn btn-light" type="reset">Reset form</button></div></form></main><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
