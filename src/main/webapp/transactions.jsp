<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,in.bankportal.util.Web" %><%List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("transactions");boolean staff=!"CUSTOMER".equals(Web.role(request));%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transactions · Bankwise</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><header class="appbar"><a class="brand" href="<%=request.getContextPath()%>/dashboard"><span class="brand-mark">B</span> Bank<span>wise</span></a><nav><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><%if(staff){%><a href="<%=request.getContextPath()%>/employee/customers">Customers</a><a href="<%=request.getContextPath()%>/employee/accounts">Accounts</a><%}%><a class="active" href="<%=request.getContextPath()%>/transactions">Transactions</a><a href="<%=request.getContextPath()%>/profile">My profile</a><a href="<%=request.getContextPath()%>/logout">Sign out</a></nav></header><main class="page-shell"><div class="welcome-row"><div><span class="eyebrow">LEDGER</span><h1>Transaction history</h1><p><%=staff?"Latest 500 transactions across the demo portal.":"Transactions for your accounts."%></p></div><div class="metric-inline"><span>Transactions shown</span><strong><%=rows==null?0:rows.size()%></strong></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Reference</th><%if(staff){%><th>Customer</th><%}%><th>Account</th><th>Type</th><th>Amount</th><th>Balance after</th><th>Description</th><th>Date</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object>r:rows){%><tr><td>#<%=r.get("transaction_id")%></td><%if(staff){%><td><%=r.get("full_name")%></td><%}%><td class="mono"><%=r.get("account_number")%></td><td><span class="pill <%=String.valueOf(r.get("transaction_type")).equals("DEPOSIT")?"pill-green":"pill-amber"%>"><%=r.get("transaction_type")%></span></td><td class="money">₹<%=r.get("amount")%></td><td class="money">₹<%=r.get("balance_after")%></td><td><%=r.get("description")%></td><td><%=r.get("transaction_date")%></td></tr><%}if(rows==null||rows.isEmpty()){%><tr><td colspan="<%=staff?8:7%>" class="empty-cell">No transactions have been recorded yet.</td></tr><%}%></tbody></table></div></section></main></body></html>
